# =============================================================================
# BuddyIO — environment template.  Copy to `.env` and fill in locally.
# `.env` is git-ignored.  NEVER commit real values, keys, or connection strings.
# =============================================================================

# ---- Phase 1 (UI-only) ---------------------------------------------------
# Which data-access implementation the Angular app binds at bootstrap.
# mock = in-memory typed fixtures (Phase 1).  http = generated REST client (Phase 3+).
BUDDYIO_DATA_SOURCE=mock

# Artificial latency (ms) applied by the mock repositories so loading/skeleton
# states are exercised during development.  Set to 0 for instant responses.
BUDDYIO_MOCK_LATENCY_MS=450

# Probability (0..1) that a mock request fails, so error states stay honest.
BUDDYIO_MOCK_ERROR_RATE=0

# ---- Phase 2+ placeholders (unused until the backend exists) -------------
# BUDDYIO_API_BASE_URL=https://localhost:7185/api/v1
# Port 5433, not 5432: the container deliberately avoids clashing with a
# locally installed PostgreSQL. See docker-compose.yml.
# BUDDYIO_POSTGRES_CONNECTION=Host=localhost;Port=5433;Database=buddyio;Username=buddyio;Password=...
# BUDDYIO_REDIS_CONNECTION=
# BUDDYIO_BLOB_ACCOUNT=
# BUDDYIO_SERVICEBUS_NAMESPACE=
# BUDDYIO_SIGNALR_ENDPOINT=
# BUDDYIO_ENTRA_TENANT_ID=
# BUDDYIO_ENTRA_CLIENT_ID=
# BUDDYIO_APPINSIGHTS_CONNECTION_STRING=
