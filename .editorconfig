root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 100

[*.ts]
quote_type = single

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{cs,csproj,sln,slnx}]
indent_size = 4

[*.{bicep,bicepparam}]
indent_size = 2
