<Project>

  <!--
    Central Package Management.

    Every version in the solution is declared exactly once, here. Project files
    carry <PackageReference Include="..." /> with NO Version attribute, so two
    projects can never silently drift onto different versions of the same
    package - the classic source of "works on my machine" in a multi-project
    solution.

    All versions below were resolved from nuget.org at the time of writing
    rather than recalled, per the project's no-invented-versions rule.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data">
    <!-- EF Core 10 ships with the .NET 10 wave; Npgsql tracks its own 10.x line. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Identity and security">
    <!--
      Password hashing is never hand-rolled. ASP.NET Core Identity's
      PasswordHasher (PBKDF2, iteration count managed by the framework) is the
      established implementation the spec requires.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Scalar renders the OpenAPI document; it replaces the old Swagger UI. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- Enforces the module boundaries recorded in ADR-0001. -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Integration tests run against a real PostgreSQL, never an in-memory fake. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

</Project>
